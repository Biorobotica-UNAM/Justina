<launch>
  <arg name="namespace" default="hardware/robotino"/>
  <arg name="use_sim_time" default="false"/>
  <arg name="slam_params_file"
       default="$(find-pkg-share slam_toolbox)/config/mapper_params_online_async.yaml"/>

  <node pkg="slam_toolbox"
        exec="async_slam_toolbox_node"
        name="slam_toolbox"
        namespace="$(var namespace)"
        output="screen">
    <param name="use_sim_time" value="$(var use_sim_time)"/>
    <param name="slam_params_file" value="$(var slam_params_file)"/>
    <remap from="scan" to="/hardware/robotino/scan"/>
    <remap from="odom" to="/hardware/robotino/odom"/>
  </node>
</launch>
